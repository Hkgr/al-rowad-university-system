meta {
  name: PUT Students By Student
  type: http
  seq: 5
}

put {
  url: {{base_url}}/v1/students/{{student_id}}
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "student_status_code": "active"
  }
}

docs {
  Graduation is intentionally unavailable. Requests resolving to `graduated`
  return HTTP 409 with `graduation_eligibility_not_implemented`.
}
