{
  "name": "AlRowad University System",
  "user": "ubuntu",
  "install": "bash .cursor/install.sh",
  "terminals": [
    {
      "name": "backend",
      "command": "cd backend && php artisan serve --host 0.0.0.0 --port 8000",
      "description": "Laravel API server (http://127.0.0.1:8000, API under /api)."
    },
    {
      "name": "frontend",
      "command": "cd frontend && npm run dev -- --host 0.0.0.0 --port 5173",
      "description": "React + Vite dev server for the SPA (http://localhost:5173)."
    }
  ],
  "ports": [
    { "name": "backend-api", "port": 8000 },
    { "name": "frontend", "port": 5173 }
  ]
}
